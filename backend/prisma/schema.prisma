generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  HOST
  MEMBER
  ANALYST
  GUEST
}


enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum AuthChallengePurpose {
  MFA_LOGIN
}

enum SessionKind {
  MEETING
  WEBINAR
}

enum SessionStatus {
  DRAFT
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
  PROCESSING
  READY
  FAILED
}

enum AgendaItemType {
  TEXT
  PRESENTATION
  WEBSITE
  VIDEO
  POLL
  WHITEBOARD
  BREAKOUT
  QA
  SCREEN_SHARE
}

enum EventStatus {
  DRAFT
  PUBLISHED
  LIVE
  ENDED
  CANCELLED
}

enum EventPresenterRole {
  ORGANIZER
  HOST
  CO_HOST
  SPEAKER
}

enum RegistrationStatus {
  REGISTERED
  WAITLISTED
  CANCELLED
  ATTENDED
  NO_SHOW
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum ArtifactStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  DELETING
  DELETED
}

enum RecordingConsentDecision {
  GRANTED
  DECLINED
  REVOKED
}

enum ChatChannel {
  EVERYONE
  HOSTS
  DIRECT
}

enum PollType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  OPEN_TEXT
  NPS
  WORD_CLOUD
}

enum PollStatus {
  DRAFT
  LIVE
  CLOSED
}

enum QuestionStatus {
  PENDING
  APPROVED
  ANSWERED
  HIDDEN
}

enum BreakoutStatus {
  DRAFT
  OPEN
  CLOSED
}

enum UploadStatus {
  AWAITING_UPLOAD
  PENDING_SCAN
  SCANNING
  READY
  REJECTED
  FAILED
  DELETED
}

enum UploadPurpose {
  SESSION_RESOURCE
  AGENDA_RESOURCE
  EVENT_RESOURCE
}

enum NotificationKind {
  BOOKING_REMINDER_24H
  BOOKING_REMINDER_1H
}

enum NotificationStatus {
  PENDING
  SENDING
  DELIVERED
  FAILED
  DEAD_LETTER
  CANCELLED
}

enum EventReminderKind {
  EVENT_REMINDER_24H
  EVENT_REMINDER_1H
}

enum EngagementEventKind {
  CHAT_MESSAGE
  CHAT_REACTION
  POLL_RESPONSE
  QUESTION_SUBMITTED
  QUESTION_VOTE
}

enum CalendarProvider {
  GOOGLE
  MICROSOFT
}

enum CalendarConnectionStatus {
  ACTIVE
  ERROR
  REVOKED
}

enum AiExternalActionKind {
  EMAIL_FOLLOW_UP
  CRM_NOTE
}

enum AiExternalActionStatus {
  DRAFT
  APPROVED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PrivacyRequestType {
  EXPORT
  ERASURE
}

enum PrivacyRequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Organization {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String                @db.VarChar(160)
  slug                String                @unique @db.VarChar(100)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspaces          Workspace[]
  memberships         WorkspaceMembership[]
  rooms               Room[]
  sessions            Session[]
  events              Event[]
  eventPresenters      EventPresenter[]
  eventRegistrations  EventRegistration[]
  bookingPages        BookingPage[]
  bookingReservations BookingReservation[]
  recordings          Recording[]
  recordingConsents   RecordingConsent[]
  transcripts         Transcript[]
  transcriptSegments  TranscriptSegment[]
  transcriptRevisions TranscriptRevision[]
  memorySummaries     MemorySummary[]
  chatMessages        ChatMessage[]
  chatReactions       ChatReaction[]
  whiteboards         Whiteboard[]
  whiteboardOperations WhiteboardOperation[]
  breakoutRooms      BreakoutRoom[]
  breakoutAssignments BreakoutAssignment[]
  breakoutAnnouncements BreakoutAnnouncement[]
  uploads             UploadAsset[]
  polls               Poll[]
  pollOptions         PollOption[]
  pollAnswers         PollAnswer[]
  questions           Question[]
  questionVotes       QuestionVote[]
  authSessions        AuthSession[]
  authChallenges      AuthChallenge[]
  workspaceInvitations WorkspaceInvitation[]
  notificationDeliveries NotificationDelivery[]
  eventNotificationTemplates EventNotificationTemplate[]
  eventNotificationDeliveries EventNotificationDelivery[]
  attendanceIntervals AttendanceInterval[]
  engagementEvents EngagementEvent[]
  calendarConnections CalendarConnection[]
  calendarOAuthStates CalendarOAuthState[]
  aiExternalActions    AiExternalAction[]
  privacyRequests      PrivacyRequest[]
  agendaTemplates      AgendaTemplate[]

  @@map("organizations")
}

model Workspace {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String                @map("organization_id") @db.Uuid
  name                String                @db.VarChar(160)
  slug                String                @db.VarChar(100)
  timezone            String                @default("UTC") @db.VarChar(100)
  settings            Json                  @default("{}")
  version             Int                   @default(1)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships         WorkspaceMembership[]
  rooms               Room[]
  sessions            Session[]
  events              Event[]
  eventPresenters      EventPresenter[]
  eventRegistrations  EventRegistration[]
  bookingPages        BookingPage[]
  bookingReservations BookingReservation[]
  recordings          Recording[]
  recordingConsents   RecordingConsent[]
  transcripts         Transcript[]
  transcriptSegments  TranscriptSegment[]
  transcriptRevisions TranscriptRevision[]
  memorySummaries     MemorySummary[]
  chatMessages        ChatMessage[]
  chatReactions       ChatReaction[]
  whiteboards         Whiteboard[]
  whiteboardOperations WhiteboardOperation[]
  breakoutRooms       BreakoutRoom[]
  breakoutAssignments BreakoutAssignment[]
  breakoutAnnouncements BreakoutAnnouncement[]
  uploads             UploadAsset[]
  polls               Poll[]
  pollOptions         PollOption[]
  pollAnswers         PollAnswer[]
  questions           Question[]
  questionVotes       QuestionVote[]
  authSessions        AuthSession[]
  authChallenges      AuthChallenge[]
  workspaceInvitations WorkspaceInvitation[]
  notificationDeliveries NotificationDelivery[]
  eventNotificationTemplates EventNotificationTemplate[]
  eventNotificationDeliveries EventNotificationDelivery[]
  attendanceIntervals AttendanceInterval[]
  engagementEvents EngagementEvent[]
  calendarConnections CalendarConnection[]
  calendarOAuthStates CalendarOAuthState[]
  aiExternalActions    AiExternalAction[]
  privacyRequests      PrivacyRequest[]
  agendaTemplates      AgendaTemplate[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("workspaces")
}

model User {
  id                      String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                   String                   @unique @db.Citext
  displayName             String                   @map("display_name") @db.VarChar(160)
  avatarUrl               String?                  @map("avatar_url") @db.Text
  passwordHash            String?                  @map("password_hash") @db.Text
  status                  UserStatus               @default(ACTIVE)
  emailVerifiedAt         DateTime?                @map("email_verified_at") @db.Timestamptz(6)
  failedLoginAttempts     Int                      @default(0) @map("failed_login_attempts")
  lockedUntil             DateTime?                @map("locked_until") @db.Timestamptz(6)
  lastLoginAt             DateTime?                @map("last_login_at") @db.Timestamptz(6)
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships             WorkspaceMembership[]
  createdSessions         Session[]                @relation("SessionCreator")
  createdEvents           Event[]                  @relation("EventCreator")
  eventPresenters          EventPresenter[]
  createdBookingPages     BookingPage[]            @relation("BookingPageCreator")
  chatMessages            ChatMessage[]            @relation("ChatMessageAuthor")
  receivedChatMessages    ChatMessage[]            @relation("ChatMessageRecipient")
  chatReactions           ChatReaction[]
  whiteboardOperations    WhiteboardOperation[]
  breakoutAssignments     BreakoutAssignment[]
  breakoutAnnouncements   BreakoutAnnouncement[]
  uploads                  UploadAsset[]
  createdPolls            Poll[]                   @relation("PollCreator")
  submittedQuestions      Question[]               @relation("QuestionAuthor")
  authSessions            AuthSession[]
  authChallenges          AuthChallenge[]
  mfaFactor               UserMfaFactor?
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  sentInvitations         WorkspaceInvitation[]    @relation("InvitationSender")
  acceptedInvitations     WorkspaceInvitation[]    @relation("InvitationAcceptor")
  recordingConsents       RecordingConsent[]
  transcriptRevisions      TranscriptRevision[]     @relation("TranscriptRevisionEditor")
  attendanceIntervals      AttendanceInterval[]
  engagementEvents         EngagementEvent[]
  calendarConnections      CalendarConnection[]
  calendarOAuthStates      CalendarOAuthState[]
  approvedAiExternalActions AiExternalAction[] @relation("AiExternalActionApprover")
  privacyRequests          PrivacyRequest[]
  createdAgendaTemplates   AgendaTemplate[]          @relation("AgendaTemplateCreator")

  @@index([status])
  @@map("users")
}

model PrivacyRequest {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  workspaceId    String               @map("workspace_id") @db.Uuid
  userId         String               @map("user_id") @db.Uuid
  type           PrivacyRequestType
  status         PrivacyRequestStatus @default(COMPLETED)
  metadata       Json                 @default("{}")
  requestedAt    DateTime             @default(now()) @map("requested_at") @db.Timestamptz(6)
  completedAt    DateTime?            @map("completed_at") @db.Timestamptz(6)
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace      Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, requestedAt])
  @@index([organizationId, workspaceId, requestedAt])
  @@map("privacy_requests")
}
model WorkspaceMembership {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  workspaceId    String        @map("workspace_id") @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  role           WorkspaceRole @default(MEMBER)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([organizationId, workspaceId])
  @@index([userId])
  @@map("workspace_memberships")
}

model Room {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  workspaceId    String       @map("workspace_id") @db.Uuid
  slug           String       @db.VarChar(100)
  title          String       @db.VarChar(160)
  settings       Json         @default("{}")
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessions       Session[]

  @@unique([workspaceId, slug])
  @@index([organizationId, workspaceId])
  @@map("rooms")
}

model Session {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String               @map("organization_id") @db.Uuid
  workspaceId          String               @map("workspace_id") @db.Uuid
  roomId               String?              @map("room_id") @db.Uuid
  createdById          String               @map("created_by_id") @db.Uuid
  title                String               @db.VarChar(160)
  description          String?              @db.Text
  kind                 SessionKind          @default(MEETING)
  status               SessionStatus        @default(DRAFT)
  startsAt             DateTime             @map("starts_at") @db.Timestamptz(6)
  durationMinutes      Int                  @map("duration_minutes")
  timezone             String               @db.VarChar(100)
  recordingEnabled     Boolean              @default(false) @map("recording_enabled")
  transcriptionEnabled Boolean              @default(false) @map("transcription_enabled")
  currentAgendaItemId  String?              @map("current_agenda_item_id") @db.Uuid
  livekitRoomName      String               @unique @map("livekit_room_name") @db.VarChar(200)
  version              Int                  @default(1)
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace            Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  room                 Room?                @relation(fields: [roomId], references: [id], onDelete: SetNull)
  createdBy            User                 @relation("SessionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  agendaItems          AgendaItem[]
  event                Event?
  bookingReservations  BookingReservation[]
  recording            Recording?
  recordingConsents    RecordingConsent[]
  transcript           Transcript?
  memorySummary        MemorySummary?
  chatMessages         ChatMessage[]
  chatReactions        ChatReaction[]
  whiteboard           Whiteboard?
  whiteboardOperations WhiteboardOperation[]
  breakoutRooms        BreakoutRoom[]
  breakoutAssignments  BreakoutAssignment[]
  breakoutAnnouncements BreakoutAnnouncement[]
  uploads              UploadAsset[]
  polls                Poll[]
  questions            Question[]
  attendanceIntervals  AttendanceInterval[]
  engagementEvents     EngagementEvent[]
  aiExternalActions     AiExternalAction[]

  @@index([organizationId, workspaceId, startsAt])
  @@index([workspaceId, status, startsAt])
  @@map("sessions")
}

model AgendaTemplate {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  workspaceId    String       @map("workspace_id") @db.Uuid
  createdById    String       @map("created_by_id") @db.Uuid
  name           String       @db.VarChar(160)
  description    String?      @db.VarChar(1000)
  items          Json         @default("[]")
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("AgendaTemplateCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([workspaceId, name])
  @@index([organizationId, workspaceId, createdAt])
  @@map("agenda_templates")
}

model AgendaItem {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  workspaceId     String         @map("workspace_id") @db.Uuid
  sessionId       String         @map("session_id") @db.Uuid
  position        Int
  title           String         @db.VarChar(160)
  durationSeconds Int            @map("duration_seconds")
  type            AgendaItemType
  content         Json           @default("{}")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  session         Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, position])
  @@index([organizationId, workspaceId, sessionId])
  @@map("agenda_items")
}

model Event {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String              @map("organization_id") @db.Uuid
  workspaceId        String              @map("workspace_id") @db.Uuid
  createdById        String              @map("created_by_id") @db.Uuid
  sessionId          String?             @unique @map("session_id") @db.Uuid
  slug               String              @db.VarChar(100)
  title              String              @db.VarChar(160)
  description        String?             @db.Text
  startsAt           DateTime            @map("starts_at") @db.Timestamptz(6)
  durationMinutes    Int                 @map("duration_minutes")
  timezone           String              @db.VarChar(100)
  capacity           Int?
  status             EventStatus         @default(DRAFT)
  registrationFields Json                @default("[]") @map("registration_fields")
  branding           Json                @default("{}")
  publishedAt        DateTime?           @map("published_at") @db.Timestamptz(6)
  version            Int                 @default(1)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy          User                @relation("EventCreator", fields: [createdById], references: [id], onDelete: Restrict)
  session            Session?            @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  registrations      EventRegistration[]
  presenters          EventPresenter[]
  notificationTemplates EventNotificationTemplate[]

  @@unique([workspaceId, slug])
  @@index([organizationId, workspaceId, startsAt])
  @@index([workspaceId, status, startsAt])
  @@map("events")
}

model EventPresenter {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  workspaceId    String             @map("workspace_id") @db.Uuid
  eventId        String             @map("event_id") @db.Uuid
  userId         String?            @map("user_id") @db.Uuid
  role           EventPresenterRole
  name           String             @db.VarChar(160)
  email          String             @db.Citext
  title          String?            @db.VarChar(160)
  bio            String?            @db.Text
  avatarUrl      String?            @map("avatar_url") @db.Text
  position       Int                @default(0)
  isPublic       Boolean            @default(true) @map("is_public")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace      Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  event          Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user           User?              @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([eventId, email])
  @@unique([eventId, position])
  @@index([organizationId, workspaceId, eventId])
  @@index([userId, eventId])
  @@map("event_presenters")
}

model EventRegistration {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  workspaceId    String             @map("workspace_id") @db.Uuid
  eventId        String             @map("event_id") @db.Uuid
  name           String             @db.VarChar(160)
  email          String             @db.Citext
  answers        Json               @default("{}")
  status         RegistrationStatus @default(REGISTERED)
  registeredAt   DateTime           @default(now()) @map("registered_at") @db.Timestamptz(6)
  checkedInAt    DateTime?          @map("checked_in_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace      Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  event          Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  notificationDeliveries EventNotificationDelivery[]
  attendanceIntervals AttendanceInterval[]

  @@unique([eventId, email])
  @@index([organizationId, workspaceId, eventId])
  @@index([eventId, status, registeredAt])
  @@map("event_registrations")
}

model BookingPage {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String               @map("organization_id") @db.Uuid
  workspaceId          String               @map("workspace_id") @db.Uuid
  createdById          String               @map("created_by_id") @db.Uuid
  slug                 String               @db.VarChar(100)
  title                String               @db.VarChar(160)
  description          String?              @db.Text
  durationMinutes      Int                  @map("duration_minutes")
  timezone             String               @db.VarChar(100)
  minimumNoticeMinutes Int                  @default(60) @map("minimum_notice_minutes")
  bufferBeforeMinutes  Int                  @default(0) @map("buffer_before_minutes")
  bufferAfterMinutes   Int                  @default(0) @map("buffer_after_minutes")
  availabilityRules    Json                 @default("[]") @map("availability_rules")
  intakeFields         Json                 @default("[]") @map("intake_fields")
  active               Boolean              @default(true)
  version              Int                  @default(1)
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace            Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy            User                 @relation("BookingPageCreator", fields: [createdById], references: [id], onDelete: Restrict)
  reservations         BookingReservation[]

  @@unique([workspaceId, slug])
  @@index([organizationId, workspaceId, active])
  @@map("booking_pages")
}

model BookingReservation {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  workspaceId    String        @map("workspace_id") @db.Uuid
  bookingPageId  String        @map("booking_page_id") @db.Uuid
  sessionId      String?       @map("session_id") @db.Uuid
  name           String        @db.VarChar(160)
  email          String        @db.Citext
  startsAt       DateTime      @map("starts_at") @db.Timestamptz(6)
  endsAt         DateTime      @map("ends_at") @db.Timestamptz(6)
  timezone            String        @db.VarChar(100)
  answers             Json          @default("{}")
  status              BookingStatus @default(CONFIRMED)
  managementTokenHash String        @map("management_token_hash") @db.VarChar(64)
  cancellationReason  String?       @map("cancellation_reason") @db.VarChar(500)
  cancelledAt         DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  rescheduledAt       DateTime?     @map("rescheduled_at") @db.Timestamptz(6)
  version             Int           @default(1)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  bookingPage    BookingPage   @relation(fields: [bookingPageId], references: [id], onDelete: Cascade)
  session        Session?      @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  notificationDeliveries NotificationDelivery[]

  @@unique([bookingPageId, startsAt])
  @@index([organizationId, workspaceId, startsAt])
  @@index([bookingPageId, status, startsAt])
  @@map("booking_reservations")
}

model NotificationDelivery {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String             @map("organization_id") @db.Uuid
  workspaceId       String             @map("workspace_id") @db.Uuid
  bookingReservationId String          @map("booking_reservation_id") @db.Uuid
  kind              NotificationKind
  status            NotificationStatus @default(PENDING)
  recipientEmail    String             @map("recipient_email") @db.Citext
  scheduledFor      DateTime           @map("scheduled_for") @db.Timestamptz(6)
