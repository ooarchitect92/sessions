generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  HOST
  MEMBER
  ANALYST
  GUEST
}

enum SessionKind {
  MEETING
  WEBINAR
}

enum SessionStatus {
  DRAFT
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
  PROCESSING
  READY
  FAILED
}

enum AgendaItemType {
  TEXT
  PRESENTATION
  WEBSITE
  VIDEO
  POLL
  WHITEBOARD
  BREAKOUT
  QA
  SCREEN_SHARE
}

model Organization {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String      @db.VarChar(160)
  slug        String      @unique @db.VarChar(100)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspaces  Workspace[]
  memberships WorkspaceMembership[]
  rooms       Room[]
  sessions    Session[]

  @@map("organizations")
}

model Workspace {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  name           String      @db.VarChar(160)
  slug           String      @db.VarChar(100)
  timezone       String      @default("UTC") @db.VarChar(100)
  settings       Json        @default("{}")
  version        Int         @default(1)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    WorkspaceMembership[]
  rooms          Room[]
  sessions       Session[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("workspaces")
}

model User {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String                @unique @db.Citext
  displayName     String                @map("display_name") @db.VarChar(160)
  avatarUrl       String?               @map("avatar_url") @db.Text
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships     WorkspaceMembership[]
  createdSessions Session[]             @relation("SessionCreator")

  @@map("users")
}

model WorkspaceMembership {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  workspaceId    String        @map("workspace_id") @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  role           WorkspaceRole @default(MEMBER)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([organizationId, workspaceId])
  @@index([userId])
  @@map("workspace_memberships")
}

model Room {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  workspaceId    String       @map("workspace_id") @db.Uuid
  slug           String       @db.VarChar(100)
  title          String       @db.VarChar(160)
  settings       Json         @default("{}")
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessions       Session[]

  @@unique([workspaceId, slug])
  @@index([organizationId, workspaceId])
  @@map("rooms")
}

model Session {
  id                       String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId           String          @map("organization_id") @db.Uuid
  workspaceId              String          @map("workspace_id") @db.Uuid
  roomId                   String?         @map("room_id") @db.Uuid
  createdById              String          @map("created_by_id") @db.Uuid
  title                    String          @db.VarChar(160)
  description              String?         @db.Text
  kind                     SessionKind     @default(MEETING)
  status                   SessionStatus   @default(DRAFT)
  startsAt                 DateTime        @map("starts_at") @db.Timestamptz(6)
  durationMinutes          Int             @map("duration_minutes")
  timezone                 String          @db.VarChar(100)
  recordingEnabled         Boolean         @default(false) @map("recording_enabled")
  transcriptionEnabled     Boolean         @default(false) @map("transcription_enabled")
  currentAgendaItemId      String?         @map("current_agenda_item_id") @db.Uuid
  livekitRoomName          String          @unique @map("livekit_room_name") @db.VarChar(200)
  version                  Int             @default(1)
  createdAt                DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization             Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace                Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  room                     Room?           @relation(fields: [roomId], references: [id], onDelete: SetNull)
  createdBy                User            @relation("SessionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  agendaItems              AgendaItem[]

  @@index([organizationId, workspaceId, startsAt])
  @@index([workspaceId, status, startsAt])
  @@map("sessions")
}

model AgendaItem {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  workspaceId     String         @map("workspace_id") @db.Uuid
  sessionId       String         @map("session_id") @db.Uuid
  position        Int
  title           String         @db.VarChar(160)
  durationSeconds Int            @map("duration_seconds")
  type            AgendaItemType
  content         Json           @default("{}")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  session         Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, position])
  @@index([organizationId, workspaceId, sessionId])
  @@map("agenda_items")
}

model IdempotencyKey {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  key            String   @db.VarChar(200)
  requestHash    String   @map("request_hash") @db.VarChar(64)
  response       Json
  statusCode     Int      @map("status_code")
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([workspaceId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model OutboxEvent {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  aggregateType  String    @map("aggregate_type") @db.VarChar(100)
  aggregateId    String    @map("aggregate_id") @db.Uuid
  eventType      String    @map("event_type") @db.VarChar(160)
  payload        Json
  attempts       Int       @default(0)
  availableAt    DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  lockedAt       DateTime? @map("locked_at") @db.Timestamptz(6)
  lockedBy       String?   @map("locked_by") @db.VarChar(160)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(6)
  lastError      String?   @map("last_error") @db.Text
  deadLetteredAt DateTime? @map("dead_lettered_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([publishedAt, deadLetteredAt, availableAt])
  @@index([workspaceId, createdAt])
  @@map("outbox_events")
}

model AuditEvent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  actorUserId    String   @map("actor_user_id") @db.Uuid
  action         String   @db.VarChar(160)
  resourceType   String   @map("resource_type") @db.VarChar(100)
  resourceId     String?  @map("resource_id") @db.Uuid
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([organizationId, workspaceId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_events")
}
