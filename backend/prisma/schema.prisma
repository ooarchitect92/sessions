generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  HOST
  MEMBER
  ANALYST
  GUEST
}


enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum AuthChallengePurpose {
  MFA_LOGIN
}

enum SessionKind {
  MEETING
  WEBINAR
}

enum SessionStatus {
  DRAFT
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
  PROCESSING
  READY
  FAILED
}

enum AgendaTimerStatus {
  IDLE
  RUNNING
  PAUSED
  EXPIRED
}

enum AgendaItemType {
  TEXT
  PRESENTATION
  WEBSITE
  VIDEO
  FILE
  POLL
  WHITEBOARD
  BREAKOUT
  QA
  SCREEN_SHARE
}

enum BreakoutRoomStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  LIVE
  ENDED
  CANCELLED
}

enum EventStageRole {
  ORGANIZER
  HOST
  COHOST
  SPEAKER
}

enum RegistrationStatus {
  REGISTERED
  WAITLISTED
  CANCELLED
  ATTENDED
  NO_SHOW
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum ArtifactStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  DELETING
  DELETED
}

enum RecordingConsentDecision {
  GRANTED
  DECLINED
  REVOKED
}

enum ChatChannel {
  EVERYONE
  HOSTS
  PRIVATE
}

enum PollType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  OPEN_TEXT
  NPS
  WORD_CLOUD
}

enum PollStatus {
  DRAFT
  LIVE
  CLOSED
}

enum QuestionStatus {
  PENDING
  APPROVED
  ANSWERED
  HIDDEN
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERING
  RETRYING
  SUCCEEDED
  FAILED
}

enum CalendarProvider {
  GOOGLE
  MICROSOFT
}

enum CalendarConnectionStatus {
  ACTIVE
  REAUTH_REQUIRED
  ERROR
  REVOKED
}

enum FileAssetStatus {
  PENDING_UPLOAD
  QUARANTINED
  SCANNING
  READY
  REJECTED
  FAILED
  DELETED
}

model Organization {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String                @db.VarChar(160)
  slug                String                @unique @db.VarChar(100)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspaces          Workspace[]
  memberships         WorkspaceMembership[]
  rooms               Room[]
  sessions            Session[]
  agendaTemplates     AgendaTemplate[]
  agendaTemplateItems AgendaTemplateItem[]
  events              Event[]
  eventSpeakers        EventSpeaker[]
  eventRegistrations  EventRegistration[]
  bookingPages        BookingPage[]
  bookingReservations BookingReservation[]
  recordings          Recording[]
  recordingConsents   RecordingConsent[]
  transcripts         Transcript[]
  transcriptSegments  TranscriptSegment[]
  memorySummaries     MemorySummary[]
  chatMessages        ChatMessage[]
  polls               Poll[]
  pollOptions         PollOption[]
  pollAnswers         PollAnswer[]
  questions           Question[]
  questionVotes       QuestionVote[]
  attendanceIntervals SessionAttendanceInterval[]
  breakoutRooms        BreakoutRoom[]
  breakoutAssignments  BreakoutAssignment[]
  whiteboards          WhiteboardDocument[]
  whiteboardOperations WhiteboardOperation[]
  fileAssets           FileAsset[]
  calendarConnections  CalendarConnection[]
  calendarBusyBlocks   CalendarBusyBlock[]
  webhookSubscriptions WebhookSubscription[]
  webhookDeliveries   WebhookDelivery[]
  authSessions        AuthSession[]
  authChallenges      AuthChallenge[]
  workspaceInvitations WorkspaceInvitation[]

  @@map("organizations")
}

model Workspace {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String                @map("organization_id") @db.Uuid
  name                String                @db.VarChar(160)
  slug                String                @db.VarChar(100)
  timezone            String                @default("UTC") @db.VarChar(100)
  settings            Json                  @default("{}")
  version             Int                   @default(1)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships         WorkspaceMembership[]
  rooms               Room[]
  sessions            Session[]
  agendaTemplates     AgendaTemplate[]
  agendaTemplateItems AgendaTemplateItem[]
  events              Event[]
  eventSpeakers        EventSpeaker[]
  eventRegistrations  EventRegistration[]
  bookingPages        BookingPage[]
  bookingReservations BookingReservation[]
  recordings          Recording[]
  recordingConsents   RecordingConsent[]
  transcripts         Transcript[]
  transcriptSegments  TranscriptSegment[]
  memorySummaries     MemorySummary[]
  chatMessages        ChatMessage[]
  polls               Poll[]
  pollOptions         PollOption[]
  pollAnswers         PollAnswer[]
  questions           Question[]
  questionVotes       QuestionVote[]
  attendanceIntervals SessionAttendanceInterval[]
  breakoutRooms        BreakoutRoom[]
  breakoutAssignments  BreakoutAssignment[]
  whiteboards          WhiteboardDocument[]
  whiteboardOperations WhiteboardOperation[]
  fileAssets           FileAsset[]
  webhookSubscriptions WebhookSubscription[]
  webhookDeliveries   WebhookDelivery[]
  authSessions        AuthSession[]
  authChallenges      AuthChallenge[]
  workspaceInvitations WorkspaceInvitation[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("workspaces")
}

model User {
  id                      String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                   String                   @unique @db.Citext
  displayName             String                   @map("display_name") @db.VarChar(160)
  avatarUrl               String?                  @map("avatar_url") @db.Text
  passwordHash            String?                  @map("password_hash") @db.Text
  status                  UserStatus               @default(ACTIVE)
  emailVerifiedAt         DateTime?                @map("email_verified_at") @db.Timestamptz(6)
  failedLoginAttempts     Int                      @default(0) @map("failed_login_attempts")
  lockedUntil             DateTime?                @map("locked_until") @db.Timestamptz(6)
  lastLoginAt             DateTime?                @map("last_login_at") @db.Timestamptz(6)
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships             WorkspaceMembership[]
  createdSessions         Session[]                @relation("SessionCreator")
  createdAgendaTemplates  AgendaTemplate[]         @relation("AgendaTemplateCreator")
  createdEvents           Event[]                  @relation("EventCreator")
  eventStageProfiles      EventSpeaker[]
  createdBookingPages     BookingPage[]            @relation("BookingPageCreator")
  chatMessages            ChatMessage[]            @relation("ChatMessageAuthor")
  receivedChatMessages    ChatMessage[]            @relation("ChatMessageRecipient")
  createdPolls            Poll[]                   @relation("PollCreator")
  submittedQuestions      Question[]               @relation("QuestionAuthor")
  authSessions            AuthSession[]
  authChallenges          AuthChallenge[]
  mfaFactor               UserMfaFactor?
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  sentInvitations         WorkspaceInvitation[]    @relation("InvitationSender")
  acceptedInvitations     WorkspaceInvitation[]    @relation("InvitationAcceptor")
  recordingConsents       RecordingConsent[]
  attendanceIntervals     SessionAttendanceInterval[]
  breakoutAssignments     BreakoutAssignment[]
  whiteboardOperations    WhiteboardOperation[]
  fileAssets               FileAsset[]
  calendarConnections      CalendarConnection[]
  createdWebhookSubscriptions WebhookSubscription[] @relation("WebhookSubscriptionCreator")

  @@index([status])
  @@map("users")
}

model WorkspaceMembership {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  workspaceId    String        @map("workspace_id") @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  role           WorkspaceRole @default(MEMBER)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([organizationId, workspaceId])
  @@index([userId])
  @@map("workspace_memberships")
}

model Room {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  workspaceId    String       @map("workspace_id") @db.Uuid
  slug           String       @db.VarChar(100)
  title          String       @db.VarChar(160)
  settings       Json         @default("{}")
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessions       Session[]

  @@unique([workspaceId, slug])
  @@index([organizationId, workspaceId])
  @@map("rooms")
}

model Session {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String               @map("organization_id") @db.Uuid
  workspaceId          String               @map("workspace_id") @db.Uuid
  roomId               String?              @map("room_id") @db.Uuid
  createdById          String               @map("created_by_id") @db.Uuid
  title                String               @db.VarChar(160)
  description          String?              @db.Text
  kind                 SessionKind          @default(MEETING)
  status               SessionStatus        @default(DRAFT)
  startsAt             DateTime             @map("starts_at") @db.Timestamptz(6)
  durationMinutes      Int                  @map("duration_minutes")
  timezone             String               @db.VarChar(100)
  recordingEnabled     Boolean              @default(false) @map("recording_enabled")
  transcriptionEnabled Boolean              @default(false) @map("transcription_enabled")
  currentAgendaItemId          String?           @map("current_agenda_item_id") @db.Uuid
  agendaTimerStatus            AgendaTimerStatus @default(IDLE) @map("agenda_timer_status")
  agendaTimerRemainingSeconds  Int               @default(0) @map("agenda_timer_remaining_seconds")
  agendaTimerEndsAt            DateTime?         @map("agenda_timer_ends_at") @db.Timestamptz(6)
  agendaTimerStartedAt         DateTime?         @map("agenda_timer_started_at") @db.Timestamptz(6)
  livekitRoomName              String            @unique @map("livekit_room_name") @db.VarChar(200)
  version              Int                  @default(1)
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace            Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  room                 Room?                @relation(fields: [roomId], references: [id], onDelete: SetNull)
  createdBy            User                 @relation("SessionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  agendaItems          AgendaItem[]
  event                Event?
  bookingReservations  BookingReservation[]
  recording            Recording?
  recordingConsents    RecordingConsent[]
  transcript           Transcript?
  memorySummary        MemorySummary?
  chatMessages         ChatMessage[]
  polls                Poll[]
  questions            Question[]
  attendanceIntervals  SessionAttendanceInterval[]
  breakoutRooms         BreakoutRoom[]
  breakoutAssignments   BreakoutAssignment[]
  whiteboard             WhiteboardDocument?
  whiteboardOperations   WhiteboardOperation[]
  fileAssets             FileAsset[]

  @@index([organizationId, workspaceId, startsAt])
  @@index([workspaceId, status, startsAt])
  @@map("sessions")
}

model WhiteboardDocument {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String                @map("organization_id") @db.Uuid
  workspaceId      String                @map("workspace_id") @db.Uuid
  sessionId        String                @unique @map("session_id") @db.Uuid
  snapshot         Json                  @default("{\"elements\":[]}")
  snapshotVersion  Int                   @default(1) @map("snapshot_version")
  compactedThrough Int                   @default(0) @map("compacted_through")
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace        Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session          Session               @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  operations       WhiteboardOperation[]

  @@index([organizationId, workspaceId, sessionId])
  @@map("whiteboard_documents")
}

model WhiteboardOperation {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  workspaceId    String             @map("workspace_id") @db.Uuid
  sessionId      String             @map("session_id") @db.Uuid
  whiteboardId   String             @map("whiteboard_id") @db.Uuid
  userId         String             @map("user_id") @db.Uuid
  operationId    String             @unique @map("operation_id") @db.Uuid
  sequence       Int
  type           String             @db.VarChar(32)
  payload        Json
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace      Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session        Session            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  whiteboard     WhiteboardDocument @relation(fields: [whiteboardId], references: [id], onDelete: Cascade)
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([whiteboardId, sequence])
  @@index([organizationId, workspaceId, sessionId, sequence])
  @@index([whiteboardId, sequence])
  @@map("whiteboard_operations")
}

model FileAsset {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String          @map("organization_id") @db.Uuid
  workspaceId      String          @map("workspace_id") @db.Uuid
  sessionId        String?         @map("session_id") @db.Uuid
  createdById      String          @map("created_by_id") @db.Uuid
  filename         String          @db.VarChar(255)
  mimeType         String          @map("mime_type") @db.VarChar(160)
  sizeBytes        BigInt          @map("size_bytes")
  checksumSha256   String?         @map("checksum_sha256") @db.VarChar(64)
  quarantineKey    String          @unique @map("quarantine_key") @db.Text
  cleanObjectKey   String?         @unique @map("clean_object_key") @db.Text
  status           FileAssetStatus @default(PENDING_UPLOAD)
  scanProvider     String?         @map("scan_provider") @db.VarChar(80)
  scanResult       String?         @map("scan_result") @db.VarChar(500)
  scanAttempts     Int             @default(0) @map("scan_attempts")
  lastScanError    String?         @map("last_scan_error") @db.Text
  uploadedAt       DateTime?       @map("uploaded_at") @db.Timestamptz(6)
  scannedAt        DateTime?       @map("scanned_at") @db.Timestamptz(6)
  deletedAt        DateTime?       @map("deleted_at") @db.Timestamptz(6)
  version          Int             @default(1)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace        Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session          Session?        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdBy        User            @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, workspaceId, createdAt])
  @@index([sessionId, status, createdAt])
  @@index([workspaceId, status, createdAt])
  @@map("file_assets")
}

model BreakoutRoom {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String             @map("organization_id") @db.Uuid
  workspaceId     String             @map("workspace_id") @db.Uuid
  sessionId       String             @map("session_id") @db.Uuid
  name            String             @db.VarChar(160)
  position        Int
  status          BreakoutRoomStatus @default(DRAFT)
  livekitRoomName String             @unique @map("livekit_room_name") @db.VarChar(220)
  openedAt        DateTime?          @map("opened_at") @db.Timestamptz(6)
  closedAt        DateTime?          @map("closed_at") @db.Timestamptz(6)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace       Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session         Session            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  assignments     BreakoutAssignment[]

  @@unique([sessionId, position])
  @@unique([sessionId, name])
  @@index([organizationId, workspaceId, sessionId, status])
  @@map("breakout_rooms")
}

model BreakoutAssignment {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  workspaceId    String       @map("workspace_id") @db.Uuid
  sessionId      String       @map("session_id") @db.Uuid
  breakoutRoomId String       @map("breakout_room_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  assignedAt     DateTime     @default(now()) @map("assigned_at") @db.Timestamptz(6)
  joinedAt       DateTime?    @map("joined_at") @db.Timestamptz(6)
  leftAt         DateTime?    @map("left_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session        Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  breakoutRoom   BreakoutRoom @relation(fields: [breakoutRoomId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([organizationId, workspaceId, sessionId])
  @@index([breakoutRoomId, assignedAt])
  @@map("breakout_assignments")
}

model SessionAttendanceInterval {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  workspaceId     String       @map("workspace_id") @db.Uuid
  sessionId       String       @map("session_id") @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  joinedAt        DateTime     @map("joined_at") @db.Timestamptz(6)
  leftAt          DateTime?    @map("left_at") @db.Timestamptz(6)
  lastHeartbeatAt DateTime     @map("last_heartbeat_at") @db.Timestamptz(6)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace       Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session         Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, workspaceId, sessionId, joinedAt])
  @@index([sessionId, userId, joinedAt])
  @@index([workspaceId, joinedAt])
  @@map("session_attendance_intervals")
}

model AgendaItem {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  workspaceId     String         @map("workspace_id") @db.Uuid
  sessionId       String         @map("session_id") @db.Uuid
  position        Int
  title           String         @db.VarChar(160)
  durationSeconds Int            @map("duration_seconds")
  type            AgendaItemType
  content         Json           @default("{}")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  session         Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, position])
  @@index([organizationId, workspaceId, sessionId])
  @@map("agenda_items")
}

model AgendaTemplate {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  workspaceId    String               @map("workspace_id") @db.Uuid
  createdById    String               @map("created_by_id") @db.Uuid
  name           String               @db.VarChar(160)
  description    String?              @db.VarChar(1000)
  version        Int                  @default(1)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace      Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy      User                 @relation("AgendaTemplateCreator", fields: [createdById], references: [id], onDelete: Restrict)
  items          AgendaTemplateItem[]

  @@unique([workspaceId, name])
  @@index([organizationId, workspaceId, createdAt])
  @@map("agenda_templates")
}

model AgendaTemplateItem {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  workspaceId     String         @map("workspace_id") @db.Uuid
  templateId      String         @map("template_id") @db.Uuid
  position        Int
  title           String         @db.VarChar(160)
  durationSeconds Int            @map("duration_seconds")
  type            AgendaItemType
  content         Json           @default("{}")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template        AgendaTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, position])
  @@index([organizationId, workspaceId, templateId])
  @@map("agenda_template_items")
}

model Event {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String              @map("organization_id") @db.Uuid
  workspaceId        String              @map("workspace_id") @db.Uuid
  createdById        String              @map("created_by_id") @db.Uuid
  sessionId          String?             @unique @map("session_id") @db.Uuid
  slug               String              @db.VarChar(100)
  title              String              @db.VarChar(160)
  description        String?             @db.Text
  startsAt           DateTime            @map("starts_at") @db.Timestamptz(6)
  durationMinutes    Int                 @map("duration_minutes")
  timezone           String              @db.VarChar(100)
  capacity           Int?
  status             EventStatus         @default(DRAFT)
  registrationFields Json                @default("[]") @map("registration_fields")
  branding           Json                @default("{}")
  publishedAt        DateTime?           @map("published_at") @db.Timestamptz(6)
  version            Int                 @default(1)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
